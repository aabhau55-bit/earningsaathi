# ─────────────────────────────────────────────────────────────
# Earning Saathi Dashboard — Platform Supabase project
# Copy this file to `.env.local` and fill in the real values.
# Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# Supabase project API (Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"

# Server-only. Full read/write, bypasses RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Postgres connection strings (Settings → Database → Connection string)
# Pooler (Transaction mode, port 6543) — use for app runtime / serverless.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-ref:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — use for migrations / schema changes.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-ref:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# App base URL (used for OAuth redirects, share links, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Referral shortlink base a creator shares (defaults to this if unset).
NEXT_PUBLIC_SHORTLINK_BASE="https://earningsaathi.com/i"
