# ─────────────────────────────────────────────────────────────
# Earning Saathi Dashboard — Platform Supabase project
# Copy this file to `.env.local` and fill in the real values.
# Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# Supabase project API (Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"

# Server-only. Full read/write, bypasses RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Postgres connection strings (Settings → Database → Connection string)
# Pooler (Transaction mode, port 6543) — use for app runtime / serverless.
DATABASE_URL="postgresql://postgres.YOUR-PROJECT-ref:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — use for migrations / schema changes.
DIRECT_URL="postgresql://postgres.YOUR-PROJECT-ref:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# App base URL (used for OAuth redirects, share links, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Referral shortlink base a creator shares (defaults to this if unset).
NEXT_PUBLIC_SHORTLINK_BASE="https://earningsaathi.com/i"

# ─────────────────────────────────────────────────────────────
# PrizeUp — live production Supabase project (separate project)
# Powers super_admin features: KPIs, user search, withdrawals,
# balance adjustments, push notifications, campaign account creation.
# ─────────────────────────────────────────────────────────────

# Direct Postgres URL to PrizeUp's DB (Settings → Database → Connection string).
PRIZEUP_DATABASE_URL="postgresql://postgres.YOUR-PRIZEUP-ref:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# PrizeUp Supabase project URL (Settings → API).
PRIZEUP_SUPABASE_URL="https://YOUR-PRIZEUP-ref.supabase.co"

# PrizeUp service-role key (Settings → API). Creates user accounts for campaigns.
PRIZEUP_SUPABASE_SERVICE_ROLE_KEY="your-prizeup-service-role-key"

# Secret for PrizeUp's `push-send` Edge Function. Server-only.
PRIZEUP_PUSH_SEND_SECRET="your-push-send-secret"

# ─────────────────────────────────────────────────────────────
# GrowBolt Offerwall
# ─────────────────────────────────────────────────────────────

# GrowBolt Offerwall SDK token (dashboard → Settings → API & Postback → API-Key).
# Served to the browser by the /growbolt wall page. Publishable by design —
# GrowBolt's docs state it only has permission to render the offerwall — but it
# lives here so it can be rotated without a code change. Leave unset and
# /growbolt renders a "being set up" notice instead of the wall.
# Must also be set in the Vercel project env for production.
GROWBOLT_SDK_TOKEN=""
